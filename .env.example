# Puerto del servidor
PORT=3000

# URL pública HTTPS donde Telegram enviará los webhooks (ej. https://api.midominio.com)
# Si se deja vacío, los bots funcionan en modo "polling" (ideal para desarrollo local).
PUBLIC_URL=

# Clave maestra (mín. 32 caracteres). Cifra los tokens de Telegram y firma las sesiones.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres-hex

# Super administrador (se crea al primer arranque)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Ruta de la base de datos SQLite
DB_PATH=./data/app.db
